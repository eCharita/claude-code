{
  "permissions": {
    "allow": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(kill *)",
      "Bash(lsof *)",
      "Bash(xargs *)",
      "Bash(curl *)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(cd *)",
      "Bash(echo *)",
      "Skill(claude-in-chrome)",
      "Bash(./scripts/setup-branch.sh *)"
    ],
    "deny": [
      "Bash(aws *)",
      "Bash(cdk *)",
      "Bash(npx cdk *)",
      "Bash(sam *)",
      "Bash(serverless *)",
      "Bash(npx serverless *)",
      "Bash(sls *)",
      "Bash(npx sls *)",
      "Bash(git push * main*)",
      "Bash(git push * master*)",
      "Bash(git push *:main*)",
      "Bash(git push *:master*)",
      "Bash(git commit * --no-verify*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-push-main.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/ticket-langsmith.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/ticket-langsmith.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/ticket-langsmith.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/ticket-langsmith.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
