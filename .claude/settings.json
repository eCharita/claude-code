{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git stash list *)",

      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh repo view *)",

      "Bash(npm install *)",
      "Bash(npm ci *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",

      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(echo *)",

      "Bash(./scripts/setup-branch.sh *)",
      "Skill(claude-in-chrome)"
    ],
    "deny": [
      "Bash(aws *)",
      "Bash(cdk *)",
      "Bash(npx cdk *)",
      "Bash(sam *)",
      "Bash(serverless *)",
      "Bash(npx serverless *)",
      "Bash(sls *)",

      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(git push * main*)",
      "Bash(git push * master*)",
      "Bash(git push *:main*)",
      "Bash(git push *:master*)",
      "Bash(git commit * --no-verify*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-push-main.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/ticket-langsmith.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/ticket-langsmith.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/ticket-langsmith.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/ticket-langsmith.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
